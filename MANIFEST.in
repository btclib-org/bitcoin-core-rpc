include LICENSE
include COPYRIGHT
include *.md
include pyproject.toml
include uv.lock
include .python-version
include .markdownlint.jsonc
# taplo's, for the same reason as the config files around it: a hook the gate
# runs reads it, and the gate has to run from an unpacked sdist. Named rather
# than covered by a glob, the only other toml at the root being
# pyproject.toml, which is named above
include .taplo.toml
# .yamllint.yaml, .pre-commit-config.yaml and .readthedocs.yaml: the lint
# gate is runnable from an unpacked sdist, and two of these three are what
# it reads. Written as a glob because there is no fourth yaml at the root
# for it to pick up by accident -- the workflows are under .github, which
# an sdist does not carry
include *.yaml
# the sdist already carries .pre-commit-config.yaml, which points at this
include .secrets.baseline

include bitcoin_core_rpc/py.typed

recursive-include tests *.json
recursive-include tests *.md
recursive-include tests *.py

recursive-exclude tests *.pyc

recursive-exclude docs/build *
recursive-include docs *.py
recursive-include docs *.md
recursive-include docs *.rst
